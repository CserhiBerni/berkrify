<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.berkrify.controllers.UserController"
      spacing="10">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10" />
    </padding>

    <Button text="Back" onAction="#handleBack"/>

    <TextField fx:id="searchField" promptText="Search by song title" maxWidth="300"/>

    <TableView fx:id="usersTable">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" />
            <TableColumn fx:id="nameColumn" text="Name" />
            <TableColumn fx:id="emailColumn" text="Email" />
            <TableColumn fx:id="createdColumn" text="Created" />
            <TableColumn fx:id="roleColumn" text="Role" />
            <TableColumn fx:id="actionColumn" text="Operations" />
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button text="Export CSV" onAction="#handleExport"/>
        <Button text="Register New User" onAction="#handleRegisterNewUser"/>
        <Button text="Statistics" onAction="#handleShowStatistics"/>
    </HBox>
</VBox>
