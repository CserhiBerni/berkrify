<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.berkrify.controllers.GenreStatsController">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    <center>
        <BarChart fx:id="genreChart" animated="false">
            <xAxis>
                <NumberAxis fx:id="xAxis" label="Count"/>
            </xAxis>
            <yAxis>
                <CategoryAxis fx:id="yAxis" label="Genre"/>
            </yAxis>
        </BarChart>
    </center>
    <bottom>
        <Button text="Back" onAction="#handleBack" BorderPane.alignment="CENTER"/>
    </bottom>
</BorderPane>
